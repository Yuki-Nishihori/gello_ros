<launch>
    <arg name="comport" default="/dev/serial/by-id/usb-STMicroelectronics_STM32_Virtual_COM_Port_2407028-if00" />
    <arg name="sampling_rate" default="1200" />
    <node name="leptrino" pkg="leptrino_force_torque" type="leptrino_force_torque"
        output="screen">
        <param name="com_port" value="$(arg comport)" />
        <param name="frame_id" value="leptrino" />
        <param name="rate" value="$(arg sampling_rate)" />
    </node>
    <node name="leptrino_ft_filter" pkg="grinding_force_torque" type="ft_filter.py"
    args="-z -t 'leptrino/wrench' -sf $(arg sampling_rate)" output="screen" />
  
</launch>  
   
  