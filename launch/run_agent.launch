<launch>
  <arg name="robot_config" default="$(find gello_ros)/config/ur5e.yaml" />
  <arg name="common_config" default="$(find gello_ros)/config/common.yaml" />
  <arg name="gello_config" default="$(find gello_ros)/config/gello.yaml" />
  <arg name="touch_config" default="$(find gello_ros)/config/touch.yaml" />
  <arg name="save_episode" default="false" />
  <arg name="agent_type" default="touch" />
  <arg name="skip_initial_move" default="true" />
  <arg name="node_start_delay" default="0" />
  <arg name="controller_type" default="cartesian_impedance_controller" doc="Controller type: joint_trajectory_controller, cartesian_compliance_controller, or cartesian_impedance_controller" />

  <node name="run_agent_node" pkg="gello_ros" type="run_agent_node.py" output="screen" launch-prefix="bash -c 'sleep $(arg node_start_delay); $0 $@' ">
    <rosparam command="load" file="$(arg robot_config)" />
    <rosparam command="load" file="$(arg common_config)" />
    <param name="save_episode" value="$(arg save_episode)" />
    <param name="agent_type" value="$(arg agent_type)" />
    <param name="skip_initial_move" value="$(arg skip_initial_move)" />
    <param name="controller_type" value="$(arg controller_type)" />
  </node>
</launch>